{
  "name": "shopifytoodoo",
  "version": "1.0.0",
  "private": true,
  "description": "Central Order Management: download Shopify orders, validate, approve and publish sales orders to Odoo 19",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.cli.ts",
    "schema:dump": "tsx src/db/dump-schema.cli.ts",
    "sync": "tsx src/cli/sync.ts",
    "seed": "tsx src/cli/seed.cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "fast-xml-parser": "^5.2.5",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "@vitest/coverage-v8": "^3.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
