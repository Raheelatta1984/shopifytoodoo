# ---------------------------------------------------------------------------
# shopifytoodoo - environment configuration
# Copy to `.env` and adjust.  Every value can also be supplied as a real
# environment variable (12 factor); the `.env` file is only a convenience for
# local development.
# ---------------------------------------------------------------------------

# --- Service ---------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# --- Datastore -------------------------------------------------------------
# Neon (or any managed Postgres) connection string.
#   direct endpoint : postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#   pooled endpoint : postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Leave empty to use the embedded PGlite database (development / demo).
DATABASE_URL=
# Used when DATABASE_URL is empty.  "memory://" keeps everything in RAM.
PGLITE_PATH=./data/pglite
DB_POOL_MAX=5
# Neon requires "require" (the direct endpoint supports "verify-full").
DB_SSL=disable

# --- Shopify ---------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2026-07
SHOPIFY_TIMEOUT_MS=30000
SHOPIFY_PAGE_SIZE=50
# Offline demo: serve the orders from a local file instead of the API.
# SHOPIFY_FIXTURE=./tests/fixtures/shopify/orders.json

# --- Odoo ------------------------------------------------------------------
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your-database
ODOO_USERNAME=admin
ODOO_PASSWORD=xxx
# xmlrpc (classic external API) or jsonrpc
ODOO_PROTOCOL=xmlrpc
ODOO_TIMEOUT_MS=30000
ODOO_CREATE_MISSING_PARTNER=true

# --- Application users (API keys) -----------------------------------------
# The keys are stored hashed; they are shown once at seed time.
ADMIN_API_KEY=change-me-admin-key
OPERATOR_API_KEY=change-me-operator-key
APPROVER_API_KEY=change-me-approver-key
AUDITOR_API_KEY=change-me-auditor-key

# --- Business defaults -----------------------------------------------------
# Orders at or above the threshold need an explicit approval.
APPROVAL_THRESHOLD_AMOUNT=1000
# Empty means "use the currency of the order being approved".
APPROVAL_THRESHOLD_CURRENCY=
SUPPORTED_CURRENCIES=AUD,USD,EUR,GBP,NZD,CAD,JPY
# Optional fallbacks used when a product or a tax has no mapping.
FALLBACK_ODOO_PRODUCT_ID=
FALLBACK_ODOO_TAX_ID=
DEFAULT_UOM_ID=
# Confirm the sales order in Odoo and read the generated pickings back.
CONFIRM_SALE_ORDER=true
